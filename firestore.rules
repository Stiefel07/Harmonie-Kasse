rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only the owner's Firebase Authentication account can access shop data.
    // Staff names are records in the cashier app, not Firebase user accounts.
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'cJsuY9YJJLP7PLabwe2niJvPgGv2';
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
